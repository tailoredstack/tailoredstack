{
  "name": "@tailoredstack/cache",
  "version": "0.1.0",
  "description": "One typed cache API over pluggable stores: memory, sqlite, redis. TanStack-style keys, tags, locks.",
  "type": "module",
  "license": "ISC",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect/index.d.ts",
      "default": "./dist/effect/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "effect": "^4.1.2",
    "ioredis": "^6.0.0",
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "biome check src test e2e vitest.config.ts vitest.e2e.config.ts",
    "lint:fix": "biome check --write src test e2e vitest.config.ts vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@testcontainers/redis": "^12.2.1",
    "@testcontainers/valkey": "^12.2.1",
    "@types/node": "^26.6.6",
    "effect": "^4.1.2",
    "ioredis": "^6.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "author": "Jose Ederango Jr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tailoredstack/tailoredstack.git",
    "directory": "packages/cache"
  },
  "homepage": "https://github.com/tailoredstack/tailoredstack/tree/main/packages/cache#readme",
  "bugs": {
    "url": "https://github.com/tailoredstack/tailoredstack/issues"
  },
  "keywords": [
    "cache",
    "typescript",
    "redis",
    "valkey",
    "sqlite",
    "memory",
    "tanstack",
    "stale-while-revalidate",
    "locks",
    "tags"
  ],
  "engines": {
    "node": ">=22.13.0"
  }
}
