{
  "name": "@tailoredstack/queue",
  "version": "0.1.0",
  "description": "Typed job queue with pluggable drivers, modeled on Laravel queues.",
  "type": "module",
  "license": "ISC",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "mutate": "node test/mutate.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "biome check src test vitest.config.ts",
    "lint:fix": "biome check --write src test vitest.config.ts"
  },
  "peerDependencies": {
    "@aws-sdk/client-sqs": "^3.1163.0",
    "ioredis": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-sqs": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-sqs": "^3.1163.0",
    "@biomejs/biome": "^2.6.5",
    "@floci/testcontainers": "0.4.0",
    "@testcontainers/redis": "^12.2.1",
    "@testcontainers/valkey": "^12.2.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "ioredis": "^6.0.0",
    "testcontainers": "^12.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "author": "Jose Ederango Jr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tailoredstack/tailoredstack.git",
    "directory": "packages/queue"
  },
  "engines": {
    "node": ">=24.16.0"
  }
}
