{
  "name": "@tailoredstack/queue",
  "version": "0.1.0",
  "description": "Typed job queue with pluggable drivers, modeled on Laravel queues.",
  "type": "module",
  "license": "ISC",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "biome check src test vitest.config.ts",
    "lint:fix": "biome check --write src test vitest.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "author": "Jose Ederango Jr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tailoredstack/tailoredstack.git",
    "directory": "packages/queue"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
